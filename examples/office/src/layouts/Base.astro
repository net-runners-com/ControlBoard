---
import { seoFor, orgJsonLd } from "@controlboard/core/seo";
import { allPageIds, pageDef, isPageHidden, isCustomId, findCustom, slugOfId } from "@controlboard/core/runtime/pages";
const { pageId, content, title, en } = Astro.props;
const seo = seoFor(pageId, content, Astro.url);
const primary = (content.theme && content.theme.primary) || "#1d7a55";
const contact = content.contact || {};
const notice = content.notice || {};
const titles = content.pageTitles || {};

/* メニューは管理画面の並び順に従う。消したページと、メニューに出さない追加ページは除く。 */
const nav = allPageIds(content)
  .filter((id) => id !== "home" && !isPageHidden(id, content))
  .filter((id) => !isCustomId(id) || (findCustom(content, slugOfId(id)) || {}).inNav)
  .map((id) => { const d = pageDef(id, content); return { id, url: d.url, label: titles[id] || d.jp || d.label }; });
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.desc} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="/site.css" />
    <style set:html={`:root{--primary:${primary}}`} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd(content))} />
  </head>
  <body>
    {notice.text ? <a class="ex-noticebar" href={notice.url || "#"}>{notice.text}</a> : null}
    <header class="ex-header">
      <div class="ex-wrap ex-header-in">
        <a class="ex-logo" href="/"><span class="ex-logo-mark">み</span>みどり会計事務所</a>
        <input type="checkbox" id="ex-nav" hidden />
        <label for="ex-nav" class="ex-burger" aria-label="メニュー">☰</label>
        <nav class="ex-nav">
          {nav.map((p) => <a href={p.url} class={here === p.url ? "is-on" : ""}>{p.label}</a>)}
        </nav>
      </div>
    </header>
    {title ? (
      <div class="ex-pagehead"><div class="ex-wrap"><p>{en}</p><h1>{title}</h1></div></div>
    ) : null}
    <main><slot /></main>
    <footer class="ex-footer">
      <div class="ex-wrap ex-footer-in">
        <div>
          <p class="ex-logo">みどり会計事務所</p>
          <p>{contact.address}</p>
          <p>TEL {contact.tel}（{contact.hours}）</p>
        </div>
        <div class="ex-footer-links">
          {(content.sns && content.sns.items || []).map((s) => <a href={s.url} rel="noopener">{s.label}</a>)}
          <a href="/admin/">管理画面</a>
        </div>
      </div>
      <p class="ex-copy">© みどり会計事務所（ControlBoard の作例）</p>
    </footer>
  </body>
</html>
